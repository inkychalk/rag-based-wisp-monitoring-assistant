# Settings for the WISP monitoring assistant (wisp_assistant.py).
#
# Rules: one setting per line, KEY=value, no spaces around "=", no quotes,
# and no comment after a value (comments go on their own line, like this one).
# A variable already set in your terminal wins over this file.
# Run this to see what the program reads (keys are not printed):
#   python wisp_assistant.py check-keys

# ======================================================================
# Which provider "ask", "chat" and "ui" use:
#   ollama, kimi, gemini, openrouter, openai or anthropic
# The compare commands use --with kimi --with gemini ... or --with all
# ======================================================================
LLM_PROVIDER=OLLAMA

# ======================================================================
# KIMI (Moonshot)
# Key: platform.moonshot.ai. Needs prepaid credit.
# Model ids for your key: python wisp_assistant.py models --provider kimi
# ======================================================================
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
# China endpoint instead of the global one:
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ======================================================================
# GEMINI (Google)
# Key: Google AI Studio (aistudio.google.com, Get API key). Usually starts with AIza
# Model ids: python wisp_assistant.py models --provider gemini
# ======================================================================
GEMINI_API_KEY=
GEMINI_MODEL=

# ======================================================================
# OPENROUTER (one key, many models; ids look like vendor/model)
# Model ids: python wisp_assistant.py models --provider openrouter --filter kimi
# ======================================================================
OPENROUTER_API_KEY=
# Examples (names change often, confirm with the models command above):
#   google/gemini-3.8-flash    fast and cheap, a good first choice
#   moonshotai/kimi-k3         Kimi flagship (moonshotai, NOT moonshot)
#   moonshotai/kimi-k2.6       cheaper Kimi
# Use a pinned name, not a "latest" alias, so your comparisons stay repeatable.
OPENROUTER_MODEL=google/gemini-3.8-flash
# Only send requests to providers that do not collect prompts:
# OPENROUTER_DATA_COLLECTION=deny

# ======================================================================
# OPENAI
# Model ids: python wisp_assistant.py models --provider openai
# ======================================================================
OPENAI_API_KEY=
OPENAI_MODEL=

# ======================================================================
# ANTHROPIC (Claude)
# Model ids: python wisp_assistant.py models --provider anthropic
# ======================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ======================================================================
# OLLAMA (runs on your own PC: free, no key, nothing leaves your machine)
# 1. Install Ollama from ollama.com and start it
# 2. Download a model, for example: ollama pull gemma4:e4b
# 3. See exact names: python wisp_assistant.py models --provider ollama
# Pick a model that fits your memory. Roughly 0.6 GB per billion parameters
# for the model, plus room for the prompt. Start small to test.
# ======================================================================
OLLAMA_MODEL=gemma4:e4b
OLLAMA_THINK=false
HF_HUB_OFFLINE=1
# Where Ollama listens. Leave this alone if you run the scripts directly on your PC.
# In Docker the compose file already points at Ollama on your PC (host.docker.internal).
# To use the ollama container from docker-compose.yml instead:
# OLLAMA_BASE_URL=http://ollama:11434
# Context window in tokens. Auto-sized from the prompt (8192 to 32768) if unset.
# Bigger uses more memory. Do not go below 8192 for this project.
# OLLAMA_NUM_CTX=16384
# For models that "think" before answering: false is much faster
# OLLAMA_THINK=false
# Local CPU answers can be slow, allow more seconds if you get a timeout
# LLM_TIMEOUT=900

# ======================================================================
# Optional, for every provider. Remove the leading # to use.
# ======================================================================
# Raise this if an answer comes back empty with finish_reason=length
# LLM_MAX_TOKENS=4000
# Only if your model supports it
# LLM_REASONING_EFFORT=low

# ======================================================================
# Web UI login (recommended, and required before you put the UI on a server)
# Without these two lines the UI has no password.
# ======================================================================
# WISP_UI_USER=
# WISP_UI_PASSWORD=
